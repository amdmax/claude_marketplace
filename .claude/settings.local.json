{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Skill(pull-request)",
      "Bash(git mv:*)",
      "Bash(git log:*)",
      "Bash(python3 -m json.tool)",
      "Bash(cd:*)",
      "Bash(mkdir -p bundles/aws/.claude-plugin bundles/aws/skills)",
      "Bash(mv \"bundles/architecture-quality/skills/aws:architect\" \"bundles/architecture-quality/skills/aws:cdk\" \"bundles/architecture-quality/skills/aws:cdk-validate\" bundles/aws/skills/)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); command=$(echo \"$input\" | jq -r '.tool_input.command'); if echo \"$command\" | grep -qE 'git push.*(\\s|/)(main|master)(\\s|$)'; then echo '❌ Blocked: direct push to main/master is not allowed' >&2; echo 'Use a feature branch and create a PR instead' >&2; exit 2; fi"
          }
        ]
      }
    ]
  }
}
