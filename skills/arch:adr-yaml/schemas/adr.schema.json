{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/amdmax/claude_marketplace/schemas/adr.schema.json",
  "title": "ADR YAML Schema",
  "description": "JSON Schema for Architecture Decision Record YAML files (MADR format)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adrVersion",
    "id",
    "title",
    "status",
    "date",
    "context",
    "options",
    "decision"
  ],
  "properties": {
    "adrVersion": {
      "type": "string",
      "description": "Schema version, e.g. \"1.0\"",
      "pattern": "^\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "description": "ADR identifier, e.g. \"ADR-0012\"",
      "pattern": "^ADR-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "description": "Kebab-case slug, e.g. \"stripe-payment-integration\"",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Decision status",
      "enum": ["proposed", "accepted", "deprecated", "superseded", "rejected"]
    },
    "date": {
      "type": "string",
      "description": "ISO date, e.g. \"2026-03-18\"",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "deciders": {
      "type": "array",
      "description": "People who made the decision",
      "items": { "type": "string" }
    },
    "consulted": {
      "type": "array",
      "description": "People who were consulted",
      "items": { "type": "string" }
    },
    "informed": {
      "type": "array",
      "description": "People who were informed",
      "items": { "type": "string" }
    },
    "context": {
      "type": "string",
      "description": "Problem statement and background",
      "minLength": 1
    },
    "decisionDrivers": {
      "type": "array",
      "description": "NFR-driven constraints influencing the decision",
      "items": { "type": "string" },
      "minItems": 1
    },
    "options": {
      "type": "array",
      "description": "Considered options (minimum 2)",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "pros", "cons"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "pros": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "cons": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "cost": {
            "type": "string"
          },
          "complexity": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen", "rationale", "consequences"],
      "properties": {
        "chosen": {
          "type": "string",
          "description": "Name of the chosen option — must match an options[].name",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "description": "Explanation of why this option was chosen",
          "minLength": 1
        },
        "consequences": {
          "type": "array",
          "description": "Good/bad consequences of the decision",
          "items": { "type": "string" },
          "minItems": 1
        },
        "confirmation": {
          "type": "string",
          "description": "Validation criteria and success metrics"
        }
      }
    },
    "moreInfo": {
      "type": "string",
      "description": "Markdown links to story, related ADRs, and external docs"
    },
    "implementationNotes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Technical implementation guidance",
      "properties": {
        "codePattern": {
          "type": "string",
          "description": "Key code snippet or pseudocode"
        },
        "migrationSteps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered steps to implement the decision"
        },
        "testingStrategy": {
          "type": "string",
          "description": "Unit/integration/e2e approach"
        },
        "rollbackPlan": {
          "type": "string",
          "description": "Procedure to revert if the decision fails"
        }
      }
    }
  }
}
