#!/bin/bash
# Stop hook: desktop notification + terminal window focus
# Fires when Claude Code finishes its turn and awaits user input

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS=$("$SCRIPT_DIR/scripts/detect-os.sh")

# Drain stdin (Stop hook sends session JSON we don't need)
cat > /dev/null

TITLE="Claude Code"
MESSAGE="Done — waiting for input"

case "$OS" in
  macos)
    osascript -e "display notification \"$MESSAGE\" with title \"$TITLE\"" 2>/dev/null || true
    for app in Warp iTerm2 Terminal Alacritty Hyper kitty Ghostty; do
      if pgrep -x "$app" &>/dev/null 2>&1; then
        osascript -e "tell application \"$app\" to activate" 2>/dev/null || true
        break
      fi
    done
    ;;
  linux)
    if command -v notify-send &>/dev/null; then
      notify-send "$TITLE" "$MESSAGE" 2>/dev/null || true
    fi
    if command -v wmctrl &>/dev/null; then
      wmctrl -a "${TERM_PROGRAM:-terminal}" 2>/dev/null || true
    elif command -v xdotool &>/dev/null; then
      xdotool search --name "terminal" windowactivate 2>/dev/null || true
    fi
    ;;
  *)
    exit 0
    ;;
esac

exit 0
